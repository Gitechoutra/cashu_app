# ─────────────────────────────────────────────────────────────────────────────
# CardVault backend configuration. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=DEV                      # DEV | PROD   (TEST is used by pytest)
APP_NAME=CardVault
APP_SECRET_KEY=change-me         # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15

# Field encryption for provider tokens:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/cardvault
AUTO_CREATE_TABLES=false         # keep false; use "flask db upgrade"

FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5050
CORS_ORIGINS=http://localhost:5173

# Sessions / app lock
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_LOCK_MINUTES=15
PIN_MAX_ATTEMPTS=5
REFRESH_COOKIE_SECURE=false      # true in production (HTTPS)

# Biometric unlock (WebAuthn). RP ID = your domain without scheme/port.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CardVault
WEBAUTHN_ORIGIN=http://localhost:5173

# OTP SMS: msg91 | fast2sms | console (console = DEV only; prints OTP to backend log)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
FAST2SMS_API_KEY=

# Rate limiting store (use redis://host:6379 in production)
RATELIMIT_STORAGE_URI=memory://

# Razorpay — key id/secret from Dashboard → Settings → API Keys (test keys start rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # Dashboard → Webhooks → secret you choose
MAX_CARD_PAYMENT_INR=500000
# BBPS bill-settlement partner. Empty = issuer is NOT credited; live payments refused.
BILL_SETTLEMENT_PROVIDER=

# Bank linking (Account Aggregator / authorised provider). Empty = "not configured".
CARD_DATA_PROVIDER=
CARD_DATA_STALE_HOURS=24
LINK_SESSION_TTL_MINUTES=20
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_BASE_URL=

# Staff PINs (exactly 6 digits) used by seeders/seed_admin.py and seeders/seed_customersupport.py.
# Staff sign in at /admin/login and /support/login with their email + this PIN.
# Mobile numbers and names are edited in those files; changing a PIN here and saving
# restarts the dev server and updates the account automatically.
ADMIN_PIN=
SUPPORT_PIN=
